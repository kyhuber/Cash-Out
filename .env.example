# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase -------------------------------------------------------------
# Project Settings -> Data API (URL) and API Keys (anon/publishable key).
#
# Note there is no NEXT_PUBLIC_ prefix: every Supabase call in this app happens
# on the server, so neither value ever reaches the browser. On Vercel these are
# ordinary (private) environment variables — no "expose to the browser" prompt.
#
# The NEXT_PUBLIC_ names still work as a fallback for an existing deployment.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- Anthropic ------------------------------------------------------------
# Server-side only. Never prefix this with NEXT_PUBLIC_ — that would ship the
# key to every browser that loads the app.
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase dashboard setup (not env vars, but required) ----------------
# Sign-in uses a 6-digit code rather than a magic link, so the session is
# created inside the installed PWA instead of in Safari.
#
# Under Authentication -> Emails -> Magic Link, the template must send the
# code rather than a link. Replace the {{ .ConfirmationURL }} anchor with:
#
#     <p>Your Cash Out sign-in code is: <strong>{{ .Token }}</strong></p>
#
# Leaving the default link template in place means verifyOtp() has no code to
# check and sign-in will fail.
